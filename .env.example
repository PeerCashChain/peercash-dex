# Copy to .env and fill in. NEVER commit .env (it holds a private key).
# Keys/custody are human-gated (RULE 6) - you run the deploy, not automation.

# Testnet (chainId 563321) first:
RPC_URL=https://<testnet-rpc-host>:8545
EXPECT_CHAIN_ID=563321

# Deployer account. Prefer an encrypted keystore over a raw key.
# Option A (recommended): decrypt a geth keystore at runtime.
#   Copy the encrypted keystore JSON to this machine, then:
KEYSTORE_PATH=C:\path\to\UTC--...--03c670916d984e8d2ff278377b38a7b4a5933bbb
# Set WALLET_PASSWORD in the shell session (not this file), e.g. in cmd:
#   set WALLET_PASSWORD=your-passphrase
# WALLET_PASSWORD=

# Option B (fallback): raw private key (plaintext on disk - avoid if possible).
# PRIVATE_KEY=0x...

# Optional: who can call factory.setFeeTo / setFeeToSetter. Defaults to deployer.
# FEE_TO_SETTER=0x...

# --- Mainnet (chainId 620156): only after a clean testnet pass. ---
# RPC_URL=https://rpc.peercash.io
# EXPECT_CHAIN_ID=620156
